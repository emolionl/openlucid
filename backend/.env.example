# Settings for `docker compose` (server mode). Copy this file to `.env` and fill in the two secrets:
#     cp .env.example .env
# Never commit .env. Make each secret with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Note: local mode (uvicorn without Docker) also reads backend/.env. It ignores the POSTGRES_* lines, and empty
# lines such as `OPENLUCID_SECRET_KEY=` count as "not set" (local mode then makes its own key).

# --- required -----------------------------------------------------------------------------

# Password of the PostgreSQL user. Use letters, digits, - and _ only (it goes into a URL).
POSTGRES_PASSWORD=

# Signs the login tokens. At least 32 characters. Changing it logs everybody out.
OPENLUCID_SECRET_KEY=

# --- optional (the values shown are the defaults) ------------------------------------------

# Close sign-ups after you made your own account (the first account becomes the admin).
OPENLUCID_ALLOW_REGISTRATION=true

# Extra web origins allowed to call the API, comma-separated (localhost is always allowed).
# Example: https://diary.example.org
OPENLUCID_CORS_ORIGINS=

# Lifetimes of the login tokens.
OPENLUCID_ACCESS_TOKEN_MINUTES=15
OPENLUCID_REFRESH_TOKEN_DAYS=30

# Largest single recording upload, in megabytes.
OPENLUCID_MAX_UPLOAD_MB=200

# Version of the privacy text people agree to when they register.
OPENLUCID_CONSENT_VERSION=2026-11

# Where the API listens on the host. Keep 127.0.0.1 and put a reverse proxy with HTTPS in front.
OPENLUCID_BIND=127.0.0.1:8000

# Address of your reverse proxy *as the API container sees it*, trusted for the X-Forwarded-For header (the login
# rate limit counts per client address). A proxy on the host (Caddy, nginx) arrives from the compose network's
# gateway, 172.30.250.1 (see docker-compose.yml), not from 127.0.0.1. A proxy in a container: use its address.
# Never use "*": then anyone can fake their address. A wrong value makes all visitors share one limit.
FORWARDED_ALLOW_IPS=172.30.250.1
